{
  "name": "film-for-you",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:mcp": "npm run dev -w apps/mcp-server",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev": "concurrently \"npm run dev:mcp\" \"npm run dev:backend\" \"npm run dev:web\""
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18",
    "next": "14.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0"
  }
}